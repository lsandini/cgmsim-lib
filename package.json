{
  "name": "@lsandini/cgmsim-lib",
  "version": "0.11.2",
  "description": "cgmsim-lib",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./ns": {
      "types": "./dist/ns/index.d.ts",
      "default": "./dist/ns/index.js"
    }
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig-build.json",
    "test:core": "jest test/core",
    "test:ns": "jest test/ns",
    "doc": "typedoc",
    "lint": "eslint",
    "test": "jest --coverage --coverageReporters json-summary",
    "test-ci": "jest --ci --coverage",
    "format": "npx prettier --write src/**/*.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsandini/cgmsim-lib.git"
  },
  "keywords": [
    "cgmsim",
    "lib"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lsandini/cgmsim-lib/issues"
  },
  "homepage": "https://github.com/lsandini/cgmsim-lib#readme",
  "devDependencies": {
    "@mxssfd/typedoc-theme": "^1.1.3",
    "@types/d3": "^7.4.0",
    "@types/fs-extra": "^9.0.13",
    "@types/jest": "^29.5.12",
    "@types/node": "20.11.0",
    "@types/node-fetch": "^2.6.7",
    "@types/sharp": "^0.31.0",
    "@typescript-eslint/eslint-plugin": "^5.25.0",
    "@typescript-eslint/parser": "^5.25.0",
    "eslint": "^8.14.0",
    "jest": "^29.7.0",
    "jest-image-snapshot": "^6.5.2",
    "prettier": "^3.1.0",
    "sharp": "^0.31.1",
    "ts-jest": "^29.4.9",
    "typedoc": "^0.25.1",
    "typedoc-plugin-markdown": "^3.16.0",
    "typedoc-plugin-missing-exports": "^2.1.0",
    "typedoc-theme-hierarchy": "^4.1.2"
  },
  "dependencies": {
    "@logtail/pino": "^0.4.10",
    "crypto": "^1.0.1",
    "d3-node": "^3.0.0",
    "dotenv": "^16.3.1",
    "fs": "^0.0.1-security",
    "fs-extra": "^10.1.0",
    "https": "^1.0.0",
    "jsdom": "^20.0.1",
    "moment": "^2.29.4",
    "node-fetch": "^2.7.0",
    "pino": "^7.10.0",
    "pino-pretty": "^7.6.1",
    "ts-dotenv": "^0.9.1",
    "tslib": "^2.6.2",
    "typescript": "^4.9.2"
  }
}
